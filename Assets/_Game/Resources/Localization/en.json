      "key": "tutorial.progress",
      "value": "First Steps · Step {step}/7"
    },
    {
      "key": "tutorial.reenter",
      "value": "Tutorial restarts at its entrance. Adventure gear and checkpoints stay separate."
    },
    {
      "key": "tutorial.step.0",
      "value": "1 Move & observe: reach the gold marker on the left with WASD, then aim toward the upper-left range."
    },
    {
      "key": "tutorial.step.1",
      "value": "2 Fire & cover: hit both gold targets in the upper-left. Walk around the wall to hit the covered target."
    },
    {
      "key": "tutorial.step.2",
      "value": "3 Dodge warnings: meet a slow bullet in the centre lane and dodge through it with Space. Retry safely if hit."
    },
    {
      "key": "tutorial.step.3",
      "value": "4 Gear: collect a coin below, take the shotgun with E and hit its target above. Fire until energy runs short, then press 1 for the pistol."
    },
    {
      "key": "tutorial.step.4",
      "value": "5 Items: take the medkit below with E and heal with Q. Then choose one of the two passive stations to the right and inspect the change."
    },
    {
      "key": "tutorial.step.5",
      "value": "6 Map & objective: open and close Tab map. Activate the upper-right beacon with E, then press E at the right-hand gate."
    },
    {
      "key": "tutorial.step.6",
      "value": "7 Final drill: defeat two guards and a low-damage elite on the right. After clearing them, press E at the exit."
    },
    {
      "key": "tutorial.step.7",
      "value": "Tutorial complete."
    },
